{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/software-release-collector/config.schema.json",
  "title": "Software release collector product config",
  "type": "object",
  "required": ["schema_version", "product", "slug", "version_source", "artifact_sources"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "edition": {"type": ["string", "null"]},
    "channel": {"type": "string", "default": "stable"},
    "version_source": {"$ref": "#/$defs/regexSource"},
    "release_date_source": {"$ref": "#/$defs/regexSource"},
    "release_page_url": {"type": "string"},
    "changelog_url": {"type": "string"},
    "artifact_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "platform", "architecture", "filename_regex"],
        "properties": {
          "url": {"type": "string"},
          "platform": {"type": "string"},
          "architecture": {"type": "string"},
          "filename_regex": {"type": "string"},
          "exclude_regex": {"type": "string"},
          "signature_suffix": {"type": "string", "default": ".asc"},
          "checksum_suffix": {"type": "string", "default": ".sha256"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "regexSource": {
      "type": "object",
      "required": ["url", "regex"],
      "properties": {
        "url": {"type": "string"},
        "regex": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
